# Copie ce fichier en .env et remplis les valeurs. Ne jamais committer .env (voir .gitignore).

# Bot Telegram : cree-le via @BotFather sur Telegram, il te donne le token.
TELEGRAM_BOT_TOKEN=

# Ton chat_id Telegram : envoie un message a ton bot puis va sur
# https://api.telegram.org/bot<TOKEN>/getUpdates pour le lire.
TELEGRAM_CHAT_ID=

# Port local sur lequel le webhook TradingView arrive.
WEBHOOK_PORT=3000

# Secret partage : a mettre aussi dans le corps de l'alerte TradingView (voir pinescript/README)
# pour verifier que le webhook vient bien de toi et pas d'un tiers qui aurait trouve l'URL.
WEBHOOK_SECRET=change-moi

# Cle API Moonx : disponible dans Moonx > Parametres > API.
# Utilisee par daytrading_cycle.py pour executer les trades XAU/USD automatiquement.
MOONX_API_KEY=
